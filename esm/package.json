{
  "name": "esm-architecture-challenge",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --watch --env-file=.env server.js",
    "seed": "node scripts/seed.js",
    "backup": "node scripts/backup.js",
    "migrate": "node migrations/migrate.js",
    "external": "json-server db.json --port 3001",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/env": "^4.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^7.7.3",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/redis": "^6.2.0",
    "@fastify/sensible": "^5.6.0",
    "@fastify/static": "^6.12.0",
    "argon2": "^0.44.0",
    "csv-parse": "^7.0.0",
    "csv-stringify": "^6.8.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^4.26.1",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.11.1",
    "md5": "^2.3.0",
    "mongoose": "^9.7.2",
    "mysql2": "^3.22.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "vitest": "^4.1.9"
  }
}
