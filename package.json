{
  "name": "framework-lab",
  "version": "1.0.0",
  "description": "Lab 3 CommonJS project",
  "main": "app.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "predev": "npm run check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check"
  },
  "dependencies": {
    "ajv": "^8.18.0"
  }
}